{
	"name": "server",
	"version": "1.0.0",
	"description": "Tredit Business Management API",
	"main": "server.js",
	"scripts": {
		"start": "node server.js",
		"dev": "nodemon server.js",
		"test": "mocha tests/**/*.test.js --timeout 10000",
		"test:watch": "nodemon --exec \"npm test\" --watch tests --watch services",
		"test:ipfs": "jest tests/routes/business.ipfs.test.js --verbose",
		"test:coverage": "jest --coverage",
		"compile": "hardhat compile --config hardhat.config.cjs",
		"deploy": "hardhat run scripts/deploy.cjs --network polygonAmoy --config hardhat.config.cjs",
		"test:hardhat": "hardhat test --config hardhat.config.cjs",
		"verify": "hardhat verify --config hardhat.config.cjs",
		"migrate": "sequelize-cli db:migrate",
		"migrate:undo": "sequelize-cli db:migrate:undo",
		"migrate:undo:all": "sequelize-cli db:migrate:undo:all"
	},
	"keywords": [],
	"author": "",
	"license": "ISC",
	"dependencies": {
		"@nomicfoundation/hardhat-toolbox": "^4.0.0",
		"@nomicfoundation/hardhat-verify": "^2.0.0",
		"@openzeppelin/contracts": "^4.9.6",
		"@pinata/sdk": "^2.1.0",
		"ajv": "^8.17.1",
		"ajv-formats": "^3.0.1",
		"axios": "^1.8.4",
		"bcryptjs": "^3.0.2",
		"body-parser": "^1.20.3",
		"compression": "^1.8.0",
		"cors": "^2.8.5",
		"dotenv": "^16.4.7",
		"express": "^4.21.2",
		"express-rate-limit": "^7.5.0",
		"express-session": "^1.18.1",
		"form-data": "^4.0.2",
		"google-auth-library": "^9.15.1",
		"googleapis": "^146.0.0",
		"hardhat": "^2.19.5",
		"helmet": "^8.0.0",
		"joi": "^17.13.3",
		"jsonwebtoken": "^9.0.2",
		"morgan": "^1.10.0",
		"multer": "^1.4.5-lts.1",
		"pg": "^8.14.0",
		"pg-hstore": "^2.3.4",
		"sequelize": "^6.37.6",
		"socket.io": "^4.8.1",
		"ua-parser-js": "^2.0.2"
	},
	"devDependencies": {
		"@nomicfoundation/hardhat-network-helpers": "^1.0.12",
		"@types/chai": "^4.3.20",
		"@types/jest": "^29.5.14",
		"@types/mocha": "^10.0.10",
		"chai": "^4.5.0",
		"hardhat-gas-reporter": "^1.0.10",
		"jest": "^29.7.0",
		"mocha": "^11.1.0",
		"nodemon": "^3.1.9",
		"sequelize-cli": "^6.6.2",
		"sinon": "^20.0.0",
		"sinon-chai": "^3.7.0",
		"solidity-coverage": "^0.8.14",
		"supertest": "^7.0.0",
		"ts-node": "^10.9.2",
		"typechain": "^8.3.2",
		"typescript": "^5.8.2"
	},
	"directories": {
		"test": "tests"
	}
}

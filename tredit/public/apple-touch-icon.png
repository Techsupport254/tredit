<?xml version="1.0" encoding="UTF-8"?>
<svg width="180" height="180" viewBox="0 0 180 180" fill="none" xmlns="http://www.w3.org/2000/svg">
    <!-- Background circle with padding for Apple -->
    <circle cx="90" cy="90" r="80" fill="url(#gradient)" />
    
    <!-- Abstract T composition -->
    <g transform="translate(90 90) scale(5)">
        <!-- Main vertical element -->
        <path d="M-3 -8
                 C-3 -8, -1 -8, 1 -8
                 L3 -8
                 C4 -8, 4 -6, 3 -4
                 L1 -2
                 C0 -1, 0 0, 0 2
                 L0 4
                 C0 6, -1 7, -3 7
                 L-4 7
                 C-5 7, -5 5, -4 4
                 L-3 3
                 C-2 2, -2 1, -2 0
                 L-2 -2
                 C-2 -3, -2.5 -3.5, -3 -4
                 L-4 -6
                 C-5 -7, -4 -8, -3 -8Z" 
              fill="white" />

        <!-- Horizontal element -->
        <path d="M-7 -8
                 C-7 -8, -5 -8, -3 -8
                 L7 -8
                 C8 -8, 8 -6, 7 -6
                 L-3 -6
                 C-5 -6, -7 -6, -7 -8Z" 
              fill="white" />

        <!-- Dynamic elements -->
        <path d="M3 -2
                 L6 1
                 C7 2, 6 3, 5 3
                 L2 0
                 C1 -1, 2 -2, 3 -2Z" 
              fill="white"
              opacity="0.9" />

        <path d="M4 2
                 L7 5
                 C8 6, 7 7, 6 7
                 L3 4
                 C2 3, 3 2, 4 2Z" 
              fill="white"
              opacity="0.7" />
    </g>

    <!-- Gradient definition -->
    <defs>
        <linearGradient id="gradient" x1="0" y1="0" x2="180" y2="180">
            <stop offset="0%" stop-color="#3B82F6"/>
            <stop offset="100%" stop-color="#1D4ED8"/>
        </linearGradient>
    </defs>
</svg> 